# ==========================================================
# Application
# ==========================================================

APP_NAME=VeriFace AI
ENVIRONMENT=ci
DEBUG=false

# ==========================================================
# Database
# ==========================================================

# Only required so Pydantic Settings can initialize.
# Tests override this with an in-memory SQLite session.
DATABASE_URL=sqlite:///:memory:

# ==========================================================
# CORS
# ==========================================================

CORS_ORIGINS=["http://localhost"]

# ==========================================================
# Face Recognition
# ==========================================================

MODEL_NAME=ArcFace
DETECTOR_BACKEND=opencv
DISTANCE_METRIC=cosine
MATCH_THRESHOLD=0.50
EMBEDDING_VERSION=arcface_v1

# ==========================================================
# Camera
# ==========================================================

CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# ==========================================================
# Authentication
# ==========================================================

SECRET_KEY=ci-test-secret-key-only-for-github-actions
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ==========================================================
# Supabase Storage
# ==========================================================

# These credentials are only used for Settings initialization.
# Storage methods should be mocked during tests whenever possible.

SUPABASE_URL=https://jrdbfwdyfyrknpyecplq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_BUCKET=face-images