# ==========================================================
# Application
# ==========================================================

APP_NAME=VeriFace AI
DEBUG=false

# ==========================================================
# Database
# ==========================================================

# CI / Docker development credentials only.
# Never place production credentials in this file.
DATABASE_URL=postgresql+psycopg://veriface:veriface_password@postgres:5432/veriface_db

# ==========================================================
# CORS
# ==========================================================

CORS_ORIGINS=http://localhost,http://localhost:3000

# ==========================================================
# Face Recognition
# ==========================================================

MODEL_NAME=ArcFace
DETECTOR_BACKEND=opencv
DISTANCE_METRIC=cosine
MATCH_THRESHOLD=0.50
EMBEDDING_VERSION=arcface_v1

# ==========================================================
# Camera
# ==========================================================

CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# ==========================================================
# Authentication
# ==========================================================

# Placeholder only. Production must provide a strong secret.
SECRET_KEY=ci-development-secret-not-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440